    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-11")
    :else (option-none-of [:option :string])))

(defn entry-field-26 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "andi.andi-del-futuro-entrepreneur-network")
    (string=? f "title") (option-some-of [:option :string] "ANDI del Futuro is ANDI's entrepreneur network, present in the Antioquia, Bogotá-Cundinamarca-Boyacá, Caldas, Norte de Santander, Santander, Valle del Cauca and Bolívar sections.")
