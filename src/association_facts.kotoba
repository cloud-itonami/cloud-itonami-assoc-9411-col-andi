(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-col-andi Wave 0 (ADR-2607141700): 27 ANDI entries, each citing a source with the page and the verbatim span it rests on. Twenty-four are ANDI's own pages and documents (statutes, four declarations and a resolution, the about, legal-affairs, economics, industry, innovation and CESLA pages) at the Internet Archive's capture of them, because andi.com.co refuses non-browser clients; three rest on es.wikipedia.org. Extend data/datascript-tx.edn and regenerate; never fabricate an id/url.")
    (option-none-of [:option :string])))

