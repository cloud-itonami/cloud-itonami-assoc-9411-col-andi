(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") 4
      (string=? candidate "governance") 16
      (string=? candidate "international") 4
      (string=? candidate "legal-status") 3
      (string=? candidate "membership") 3
      (string=? candidate "policy") 7
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") (cond
        (= i 0) (entry-field a 15 "id")
        (= i 1) (entry-field a 16 "id")
        (= i 2) (entry-field a 17 "id")
        (= i 3) (entry-field a 18 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
