 ;; ---- the 'Quiénes Somos' page: nature, seat, the Mega ----
 #:association-rule{:id "andi.nonprofit-free-enterprise-purpose"
                    :title "ANDI describes itself as a non-profit business association whose objective is to spread and foster the political, economic and social principles of a sound free-enterprise system."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :legal-status
                    :url "https://web.archive.org/web/20260827155317/https://www.andi.com.co/Home/Pagina/1-quienes-somos"
                    :url-provenance :official-andi-archived
                    :source-article "Quiénes Somos (andi.com.co, Internet Archive capture of 2026-08-27)"
                    :source-quote "La Asociación Nacional de Empresarios de Colombia (ANDI), es una agremiación sin ánimo de lucro, que tiene como objetivo difundir y propiciar los principios políticos, económicos y sociales de un sano sistema de libre empresa."
                    :date-unknown-because :page-states-standing-purpose-undated
                    :retrieved-at "2026-09-11"
                    :topic [:governance :legal-status]}
 #:association-rule{:id "andi.seat-medellin-and-regional-offices"
                    :title "ANDI's principal seat is in Medellín, with offices in Barranquilla, Bogotá, Bucaramanga, Cali, Cartagena, Cúcuta, Ibagué, Manizales, Pereira, Santander de Quilichao and Villavicencio. (The English-language page says 'headquarters in Bogotá'; the statutes and the Spanish page say Medellín, and the statutory domicile is what this catalog asserts.)"
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :governance-program
                    :url "https://web.archive.org/web/20260827155317/https://www.andi.com.co/Home/Pagina/1-quienes-somos"
                    :url-provenance :official-andi-archived
                    :source-article "Quiénes Somos (andi.com.co, Internet Archive capture of 2026-08-27)"
                    :source-quote "La sede principal de la ANDI se encuentra en Medellín y cuenta con sedes en Barranquilla, Bogotá, Bucaramanga, Cali, Cartagena, Cúcuta, Ibagué, Manizales, Pereira, Santander de Quilichao y Villavicencio."
                    :date-unknown-because :page-states-a-standing-arrangement
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.mega-2025"
                    :title "ANDI's 'Apuesta Mega 2025': to lead, from the business sector, the country's economic reactivation, and to contribute to Colombia being one of the three most competitive countries in Latin America by 2025. The page does not date when the Mega was adopted; 2025 is its target year, not its adoption."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :policy-program
                    :url "https://web.archive.org/web/20260827155317/https://www.andi.com.co/Home/Pagina/1-quienes-somos"
                    :url-provenance :official-andi-archived
                    :source-article "Quiénes Somos (andi.com.co, Internet Archive capture of 2026-08-27)"
                    :source-quote "La ANDI liderará activamente, desde el sector empresarial, la reactivación económica del país, con propuestas que generen empleo de calidad y aceleren el crecimiento en el corto plazo, contribuirá con acciones a que en 2025 Colombia sea uno de los tres países más competitivos de América Latina"
                    :date-unknown-because :page-does-not-date-the-strategy
                    :retrieved-at "2026-09-11"
                    :topic [:policy]}

 ;; ---- the statutes (ANDI's own PDF; signed 'Cartagena, Agosto 10 y 11 de
 ;;      2017', document control 'CD-GE-07 V:04 F.A: 14/08/2015') ----
 #:association-rule{:id "andi.statutes-legal-nature-and-acronym"
                    :title "Statutes, Article 1: ANDI is a civil-law juridical person of the corporation kind, non-profit, permanent, and identified by the acronym ANDI."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 1. La Asociación Nacional de Empresarios de Colombia es una persona jurídica de derecho civil perteneciente a la especie de las corporaciones, sin ánimo de lucro, con capacidad para adquirir, poseer, gravar y enajenar bienes. La Asociación tendrá carácter permanente. Se identificará con la sigla ANDI."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance :legal-status]}
 #:association-rule{:id "andi.statutes-domicile-medellin"
                    :title "Statutes, Article 2: the association's domicile is the city of Medellín; it may open offices in the country or abroad."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 2. La Asociación tendrá como domicilio la ciudad de Medellín, pudiendo abrir oficinas en el país o en el exterior"
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-object-free-enterprise"
                    :title "Statutes, Article 4(a): the first object is to defend, promote and spread the political, economic and social principles of the free-enterprise system, grounded in human dignity, liberty, political democracy, social justice and respect for private property."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "a) Defender, fomentar y difundir los principios políticos, económicos y sociales del sistema de libre empresa, basado en la dignidad humana, en la libertad, la democracia política, la justicia social y el respeto a la propiedad privada."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-governing-bodies"
                    :title "Statutes, Article 9: national governance rests with the General Assembly of Members, the Junta de Dirección General and the Presidency; regional assemblies and boards govern at the sectional level."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 9. La dirección de la Asociación en el orden nacional corresponde a los siguientes órganos: Asamblea General de Afiliados, Junta de Dirección General y Presidencia de la Asociación."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-junta-composition"
                    :title "Statutes, Article 20: the Junta de Dirección General comprises the presidents of the sectional boards, eleven members elected by the sectional boards, eight designated by the sectoral chambers and two designated by Fundación ANDI."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "b) Once (11) miembros elegidos por las Juntas Directivas Seccionales c) Ocho (8) designados por las Cámaras Sectoriales. d) Dos (2) miembros designados por la Fundación ANDI."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-president-legal-representative"
                    :title "Statutes, Article 36: the President is the association's legal representative, holds its government and direct administration, is elected by the Junta de Dirección General for two-year terms and may be re-elected indefinitely."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 36. El Presidente es el representante legal de la Asociación. El gobierno y la administración directa de la misma estarán a su cargo. Será elegido por la Junta de Dirección General para períodos de dos (2) años pero podrá ser reelegido indefinidamente."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-sectoral-chambers"
                    :title "Statutes, Article 54: on the President's initiative or at the request of a reasonable and representative number of members in a homogeneous economic activity, the Junta de Dirección General may create sectoral or sub-sectoral chambers."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :membership-rule
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 54. Por iniciativa del Presidente de la Asociación o por solicitud de un número razonable y representativo de afiliados dedicados a una actividad económica homogénea, la Junta de Dirección General podrá crear cámaras de carácter sectorial o subsectorial"
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance :membership]}
 #:association-rule{:id "andi.statutes-reform-two-thirds"
                    :title "Statutes, Article 61: amending the statutes requires a qualified vote of at least two thirds of the votes accredited at the General Assembly of Members."
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 61. La reforma de estos Estatutos requerirá la votación calificada de por lo menos dos terceras partes de los votos acreditados en la respectiva Asamblea General de Afiliados."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance]}
 #:association-rule{:id "andi.statutes-dissolution-assets"
                    :title "Statutes, Article 63: on dissolution the remaining assets go entirely to the non-profit corporations and foundations the entity has constituted; failing those, to institutions of the same nature devoted to social welfare, science or education. (Article 14(e) sets the dissolution vote at 70% of all members.)"
                    :association "andi"
                    :isic "9411"
                    :country "COL"
                    :kind :charter
                    :url "https://web.archive.org/web/20240908134605/https://andi.com.co/Uploads/ESTATUTOS%20ANDI.pdf"
                    :url-provenance :official-andi-archived
                    :source-article "Estatutos Asociación Nacional de Empresarios de Colombia - ANDI (PDF, Internet Archive capture of 2024-09-08)"
                    :source-quote "ARTÍCULO 63. En caso de disolución, el patrimonio relicto se destinará en su totalidad a las corporaciones y fundaciones sin ánimo de lucro que la entidad hubiere constituido y que existan en ese momento."
                    :date-quote "Cartagena, Agosto 10 y 11 de 2017"
                    :last-revised-date "2017-08"
                    :date-precision :month
                    :retrieved-at "2026-09-11"
                    :topic [:governance :legal-status]}

