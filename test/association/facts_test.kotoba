(ns association.facts-test
  "The Clojure reading of the ANDI catalog, checked against the data file it
  is generated from. Counts are READ from data/datascript-tx.edn rather than
  written here: this file used to say `(= 2 (count sb))`, which was true of a
  two-entry catalog and would have been a dormant lie the day the catalog
  grew -- and dormant is what this suite is under `kbb -M:test` (see the
  parity test's docstring; `kbb -M:parity` runs both)."
  (:require [clojure.test :refer [deftest is]]
            [clojure.edn :as edn]
            [association.facts :as facts]))

(def ^:private data (edn/read-string (slurp "data/datascript-tx.edn")))

(deftest the-data-file-is-not-empty
  ;; Every count below would agree on zero.
  (is (pos? (count data))))

(deftest andi-has-spec-basis
  (let [sb (facts/spec-basis "andi")]
    (is (= (count data) (count sb)))
    (is (= (mapv :association-rule/id data) (mapv :association-rule/id sb)))
    (is (every? #(= "9411" (:association-rule/isic %)) sb))
    (is (every? #(= "COL" (:association-rule/country %)) sb))
    (is (every? #(clojure.string/starts-with? (:association-rule/url %) "https://") sb))))

(deftest archived-first-party-entries-wrap-andi-originals
  ;; The structural checker enforces this too; here it is asserted on the
  ;; Clojure reading, so a regenerated reading that lost the binding between
  ;; provenance and host would not pass on the strength of the data file alone.
  (let [archived (filter #(= :official-andi-archived (:association-rule/url-provenance %))
                         (facts/spec-basis "andi"))]
    (is (pos? (count archived)))
    (doseq [e archived]
      (is (re-matches #"https://web\.archive\.org/web/\d{14}/https?://(www\.)?andi\.com\.co/.*"
                      (:association-rule/url e))
          (:association-rule/id e)))))

(deftest unknown-association-has-no-spec-basis
  (is (nil? (facts/spec-basis "ibec")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["andi" "ibec"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["ibec"] (:missing-associations c)))))

(deftest by-topic-filters
  (let [governance-in-data (count (filter #(some #{:governance} (:association-rule/topic %)) data))]
    (is (pos? governance-in-data))
    (is (= governance-in-data (count (facts/by-topic "andi" :governance)))))
  (is (empty? (facts/by-topic "andi" :labor)))
  (is (empty? (facts/by-topic "ibec" :governance))))
